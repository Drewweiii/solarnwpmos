# Copy to .env and fill in for your environment. All vars are prefixed HIMAWARI_
# (see src/himawari_ingestion/config.py:Settings for the authoritative list/defaults).

HIMAWARI_SITE_LATITUDE=12.71
HIMAWARI_SITE_LONGITUDE=101.15

# "mock" (default, safe) replays fixtures/sample_himawari_response.json.
# "http" reads the real NOAA AHI-L2-FLDK-Clouds product - see README "Data source".
HIMAWARI_SOURCE_MODE=mock

# NOAA/NESDIS AHI cloud product on AWS Open Data. Public, no credentials required.
HIMAWARI_NOAA_BUCKET=noaa-himawari9
HIMAWARI_NOAA_PRODUCT_PREFIX=AHI-L2-FLDK-Clouds
HIMAWARI_NOAA_FILE_PREFIX=AHI-CMSK
HIMAWARI_PUBLISH_LATENCY_MINUTES=55
HIMAWARI_LOOKBACK_SLOTS=6

HIMAWARI_USER_AGENT=NongFabEMS-HimawariIngestion/0.2 (+https://github.com/Drewweiii/solarnwpmos; contact=ops@nongfab-ems.example)

HIMAWARI_REQUEST_TIMEOUT_SECONDS=30
HIMAWARI_MIN_SECONDS_BETWEEN_REQUESTS=2
HIMAWARI_MAX_RETRY_ATTEMPTS=4
HIMAWARI_RETRY_BACKOFF_BASE_SECONDS=2
HIMAWARI_RETRY_BACKOFF_MAX_SECONDS=30

HIMAWARI_POLL_INTERVAL_MINUTES=10

HIMAWARI_MINIO_ENDPOINT=localhost:9000
HIMAWARI_MINIO_ACCESS_KEY=minioadmin
HIMAWARI_MINIO_SECRET_KEY=minioadmin
HIMAWARI_MINIO_SECURE=false
HIMAWARI_MINIO_BUCKET=himawari-raw

HIMAWARI_TIMESCALE_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/nongfab_ems

HIMAWARI_METRICS_PORT=9101
