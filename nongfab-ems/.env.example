# Copy to .env before running `docker compose up`.

# --- Postgres / TimescaleDB (shared by the app tables and MLflow's backend store) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nongfab_ems

# --- MinIO (S3-compatible object storage; also used as MLflow's artifact store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- MLflow ---
# NOTE: named MLFLOW_MINIO_* rather than the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# on purpose - if your shell already has real AWS credentials exported (common with the AWS
# CLI configured), Docker Compose prefers *shell* env vars over this file, and those real
# credentials would silently leak into the mlflow container instead of the MinIO ones below.
MLFLOW_BACKEND_STORE_URI=postgresql://postgres:postgres@timescaledb:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_MINIO_ACCESS_KEY=minioadmin
MLFLOW_MINIO_SECRET_KEY=minioadmin

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Dashboard (web) ---
VITE_API_URL=http://localhost:8000
